<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_background"
    android:padding="20dp"
    android:layout_margin="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/choose_accent"
        android:textColor="@color/widget_text"
        android:textSize="16sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="20dp">

        <View
            android:id="@+id/swatch_red"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/circle_swatch"
            android:backgroundTint="#FF3B30"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:id="@+id/swatch_blue"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/circle_swatch"
            android:backgroundTint="#0A84FF"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:id="@+id/swatch_green"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/circle_swatch"
            android:backgroundTint="#30D158"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:id="@+id/swatch_orange"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/circle_swatch"
            android:backgroundTint="#FF9F0A"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:id="@+id/swatch_purple"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/circle_swatch"
            android:backgroundTint="#BF5AF2"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</LinearLayout>
