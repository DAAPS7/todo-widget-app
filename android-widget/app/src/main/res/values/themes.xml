<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Tarefas" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorBackground">@color/app_background</item>
        <item name="android:windowBackground">@color/app_background</item>
    </style>

    <style name="Theme.Tarefas.Dialog" parent="android:Theme.Material.Light.Dialog.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:colorBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>
</resources>
